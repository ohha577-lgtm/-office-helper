/* =====================================================================
   engine.js  —  양식 채우기 엔진
   ※ 이 파일은 고칠 필요가 없습니다.
   ※ 모든 처리는 사용자의 컴퓨터(브라우저) 안에서만 일어나고,
     파일은 어떤 서버에도 저장되지 않습니다.
   ===================================================================== */
(function (root) {
  'use strict';

  /* ---------- 작은 도구들 ---------- */
  const MARK = /\{\{\s*([^{}]+?)\s*\}\}/g;          // {{항목}} 표시
  const HAS_MARK = /\{\{[^{}]+\}\}/;

  function norm(s) {                                   // 비교용: 띄어쓰기·기호 없애기
    return String(s == null ? '' : s)
      .replace(/[\s :：·•\-_()（）\[\]【】<>「」*※]/g, '')
      .toLowerCase();
  }
  function extOf(name) {
    const m = /\.([^.]+)$/.exec(name || '');
    return m ? m[1].toLowerCase() : '';
  }
  function isLabel(s) {
    s = String(s || '').trim();
    return s.length > 0 && s.length <= 20 && !HAS_MARK.test(s) &&
      !/^[\d\s.,\-/:%]+$/.test(s);
  }
  function walk(node, fn) {                            // 문서 순서대로 모든 노드 방문
    const stack = [node];
    while (stack.length) {
      const n = stack.pop();
      fn(n);
      const ch = [];
      for (let c = n.firstChild; c; c = c.nextSibling) ch.push(c);
      for (let i = ch.length - 1; i >= 0; i--) stack.push(ch[i]);
    }
  }
  function els(node, name) {
    const out = [];
    walk(node, n => { if (n.nodeType === 1 && n.localName === name) out.push(n); });
    return out;
  }
  function kids(node, name) {
    const out = [];
    for (let c = node.firstChild; c; c = c.nextSibling)
      if (c.nodeType === 1 && c.localName === name) out.push(c);
    return out;
  }
  function up(node, name) {
    let n = node.parentNode;
    while (n && n.nodeType === 1) { if (n.localName === name) return n; n = n.parentNode; }
    return null;
  }
  function textEls(node) { return els(node, 't').filter(t => !up(t, 'rPh')); }
  function ownTs(p) { return textEls(p).filter(t => up(t, 'p') === p); }
  function paraText(p) { return ownTs(p).map(t => t.textContent).join(''); }
  function textOf(node) { return node ? textEls(node).map(t => t.textContent).join('') : ''; }
  function cellText(tc) { return els(tc, 'p').map(paraText).join(' ').trim(); }

  function parseXml(str) { return new root.DOMParser().parseFromString(str, 'application/xml'); }
  function serXml(doc) {
    let s = new root.XMLSerializer().serializeToString(doc);
    if (!/^<\?xml/.test(s)) s = '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>' + s;
    return s;
  }
  function numSort(a, b) {
    const na = +((/(\d+)\.xml$/.exec(a) || [0, 0])[1]), nb = +((/(\d+)\.xml$/.exec(b) || [0, 0])[1]);
    return na - nb || (a < b ? -1 : 1);
  }
  function xmlParts(zip, ext) {
    const re = ext === 'hwpx' ? /^Contents\/section\d+\.xml$/i
      : ext === 'docx' ? /^word\/(document|header\d*|footer\d*)\.xml$/i
      : /^ppt\/slides\/slide\d+\.xml$/i;
    return Object.keys(zip.files).filter(n => !zip.files[n].dir && re.test(n)).sort(numSort);
  }
  function setText(t, s) {
    t.textContent = s;
    if (t.localName === 't' && /wordprocessingml/.test(t.namespaceURI || ''))
      t.setAttributeNS('http://www.w3.org/XML/1998/namespace', 'xml:space', 'preserve');
  }

  /* 오래된 형식 안내 */
  const OLD_MSG = {
    hwp: '예전 한글 파일(.hwp)은 열 수 없어요. 한글에서 [다른 이름으로 저장 → 파일 형식: 한글 표준 문서(*.hwpx)]로 저장한 뒤 올려 주세요.',
    ppt: '예전 파워포인트 파일(.ppt)은 열 수 없어요. 파워포인트에서 [다른 이름으로 저장 → .pptx]로 저장한 뒤 올려 주세요.',
    doc: '예전 워드 파일(.doc)은 열 수 없어요. 워드에서 [다른 이름으로 저장 → .docx]로 저장한 뒤 올려 주세요.',
    xlsForm: '양식으로는 예전 엑셀 파일(.xls)을 쓸 수 없어요(칸 모양이 깨집니다). 엑셀에서 [다른 이름으로 저장 → Excel 통합 문서(*.xlsx)]로 저장한 뒤 올려 주세요.'
  };

  /* =================================================================
     1. 자료 파일 읽기  →  rows (줄마다 칸 글자 목록)
     ================================================================= */
  function rowsFromDoc(doc) {
    const rows = [];
    els(doc, 'tr').forEach(tr => rows.push(kids(tr, 'tc').map(cellText)));
    els(doc, 'p').forEach(p => {
      if (up(p, 'tc')) return;
      const t = paraText(p).trim();
      if (t) rows.push([t]);
    });
    return rows;
  }

  async function pdfRows(buf) {
    const lib = root.pdfjsLib;
    const pdf = await lib.getDocument({ data: new Uint8Array(buf.slice(0)) }).promise;
    const rows = [];
    for (let i = 1; i <= pdf.numPages; i++) {
      const page = await pdf.getPage(i);
      const tc = await page.getTextContent();
      const lines = [];
      tc.items.forEach(it => {
        if (!it.str || !it.str.trim()) return;
        const x = it.transform[4], y = it.transform[5];
        const h = Math.hypot(it.transform[2], it.transform[3]) || 10;
        let line = lines.find(l => Math.abs(l.y - y) < h * 0.5);
        if (!line) { line = { y, items: [] }; lines.push(line); }
        line.items.push({ x, w: it.width, s: it.str, h });
      });
      lines.sort((a, b) => b.y - a.y);
      lines.forEach(l => {
        l.items.sort((a, b) => a.x - b.x);
        const cells = [];
        let cur = null;
        l.items.forEach(it => {
          const gap = cur ? it.x - (cur.x + cur.w) : 1e9;
          if (cur && gap < it.h * 0.9) {
            cur.s += (gap > it.h * 0.15 ? ' ' : '') + it.s;
            cur.w = it.x + it.w - cur.x;
          } else { cur = Object.assign({}, it); cells.push(cur); }
        });
        rows.push(cells.map(c => c.s.trim()).filter(Boolean));
      });
    }
    return rows;
  }

  async function readDataFile(name, buf) {
    const ext = extOf(name);
    if (['xlsx', 'xlsm', 'xls', 'csv', 'ods'].includes(ext)) {
      const wb = root.XLSX.read(buf, { type: 'array' });
      const rows = [], headers = new Set();
      wb.SheetNames.forEach(sn => {
        const a = root.XLSX.utils.sheet_to_json(wb.Sheets[sn], { header: 1, raw: false, defval: '' })
          .map(r => r.map(v => String(v == null ? '' : v).trim()))
          .filter(r => r.some(Boolean));
        // 첫 줄이 '성명 | 학년 | 반 …' 같은 제목 줄인지 살펴보기 (명단형 표)
        if (a.length >= 2) {
          const h = a[0].filter(Boolean), d = a[1].filter(Boolean);
          if (h.length >= 3 && a[0].every(c => !c || isLabel(c) && !/\d/.test(c)) && d.length >= h.length - 1)
            headers.add(rows.length);
        }
        a.forEach(r => rows.push(r));
        rows.push([]);
      });
      return { name, rows, headers };
    }
    if (['hwpx', 'docx', 'pptx'].includes(ext)) {
      const zip = await root.JSZip.loadAsync(buf);
      const rows = [];
      for (const path of xmlParts(zip, ext))
        rows.push(...rowsFromDoc(parseXml(await zip.file(path).async('string'))), []);
      return { name, rows };
    }
    if (ext === 'pdf') return { name, rows: await pdfRows(buf) };
    if (ext === 'txt') {
      const txt = new TextDecoder('utf-8').decode(buf);
      return { name, rows: txt.split(/\r?\n/).map(s => s.trim()).filter(Boolean).map(s => [s]) };
    }
    if (OLD_MSG[ext]) throw new Error(OLD_MSG[ext]);
    throw new Error('이 형식(.' + ext + ')은 읽을 수 없어요.');
  }

  /* =================================================================
     2. 자료에서 항목 값 찾기
     ================================================================= */
  function findValue(datas, key, keySet) {
    // (1) "성명: 홍길동" 처럼 한 칸 안에 있는 경우
    for (const d of datas) for (const row of d.rows) for (const cell of row) {
      const m = /^(.{1,30}?)\s*[:：]\s*(.+)$/.exec(cell);
      if (m && norm(m[1]) === key) return { value: m[2].trim(), from: d.name };
    }
    // (2) 표에서 '성명' 칸의 오른쪽(없으면 아래쪽) 칸
    for (const d of datas) {
      const rows = d.rows;
      for (let r = 0; r < rows.length; r++) {
        const row = rows[r];
        for (let i = 0; i < row.length; i++) {
          if (norm(row[i]) !== key) continue;
          if (d.headers && d.headers.has(r)) {             // 명단형: 바로 아래 칸
            const b = rows[r + 1] && rows[r + 1][i] ? String(rows[r + 1][i]).trim() : '';
            if (b) return { value: b, from: d.name };
            continue;
          }
          let j = i + 1;
          while (j < row.length && !String(row[j]).trim()) j++;
          const right = j < row.length ? String(row[j]).trim() : '';
          if (right && !keySet.has(norm(right))) return { value: right, from: d.name };
          const below = rows[r + 1] && rows[r + 1][i] ? String(rows[r + 1][i]).trim() : '';
          if (below && !keySet.has(norm(below))) return { value: below, from: d.name };
        }
      }
    }
    // (3) "성명 홍길동" 처럼 한 줄 글
    for (const d of datas) for (const row of d.rows) {
      if (row.length !== 1) continue;
      const m = /^(\S+)\s+(.+)$/.exec(String(row[0]).trim());
      if (m && norm(m[1]) === key) return { value: m[2].trim(), from: d.name };
    }
    return null;
  }

  function matchAll(fields, datas) {
    const keySet = new Set(fields.map(f => f.key));
    const out = {};
    fields.forEach(f => { out[f.key] = findValue(datas, f.key, keySet); });
    return out;
  }

  /* =================================================================
     3. 양식 파일 분석하고 채우기
     ================================================================= */
  function FieldList() {
    const map = new Map();
    return {
      add(label) {
        const key = norm(label);
        if (!key) return null;
        if (!map.has(key)) map.set(key, { key, label: String(label).trim() });
        return key;
      },
      list() { return Array.from(map.values()); }
    };
  }
  function replaceMarks(s, values) {
    return s.replace(MARK, (all, k) => { const v = values[norm(k)]; return v == null ? '' : String(v); });
  }
  function removeLineSeg(p) { kids(p, 'linesegarray').forEach(x => p.removeChild(x)); }

  function fillMarkerPara(p, values, ext) {
    const ts = p.localName === 'p' ? ownTs(p) : textEls(p);
    ts.forEach(t => { if (HAS_MARK.test(t.textContent)) setText(t, replaceMarks(t.textContent, values)); });
    const full = ts.map(t => t.textContent).join('');
    if (HAS_MARK.test(full) && ts.length) {             // 표시가 여러 조각으로 나뉜 경우
      setText(ts[0], replaceMarks(full, values));
      for (let i = 1; i < ts.length; i++) setText(ts[i], '');
    }
    if (ext === 'hwpx') removeLineSeg(p);
  }

  function writeIntoCell(tc, v, ext) {
    const p = els(tc, 'p')[0];
    if (!p) return;
    const doc = p.ownerDocument, ns = p.namespaceURI, pre = p.prefix ? p.prefix + ':' : '';
    if (ext === 'hwpx') {
      let run = kids(p, 'run')[0];
      if (!run) {
        run = doc.createElementNS(ns, pre + 'run');
        run.setAttribute('charPrIDRef', '0');
        p.insertBefore(run, kids(p, 'linesegarray')[0] || null);
      }
      const t = doc.createElementNS(ns, pre + 't');
      t.textContent = v;
      run.appendChild(t);
      removeLineSeg(p);
    } else if (ext === 'docx') {
      const r = doc.createElementNS(ns, pre + 'r');
      const pPr = kids(p, 'pPr')[0];
      const rp = pPr && kids(pPr, 'rPr')[0];
      if (rp) r.appendChild(rp.cloneNode(true));
      const t = doc.createElementNS(ns, pre + 't');
      setText(t, v);
      r.appendChild(t);
      p.appendChild(r);
    } else if (ext === 'pptx') {
      const r = doc.createElementNS(ns, pre + 'r');
      const end = kids(p, 'endParaRPr')[0];
      const rPr = doc.createElementNS(ns, pre + 'rPr');
      if (end) {
        Array.from(end.attributes).forEach(a => rPr.setAttribute(a.name, a.value));
        for (let c = end.firstChild; c; c = c.nextSibling) rPr.appendChild(c.cloneNode(true));
      } else rPr.setAttribute('lang', 'ko-KR');
      r.appendChild(rPr);
      const t = doc.createElementNS(ns, pre + 't');
      t.textContent = v;
      r.appendChild(t);
      p.insertBefore(r, end || null);
    }
  }

  /* ---- 한글(hwpx) · 워드(docx) · 파워포인트(pptx) ---- */
  async function loadZipForm(buf, ext) {
    const zip = await root.JSZip.loadAsync(buf);
    const fl = FieldList();
    const docs = {}, markerParas = [], blanks = [];
    for (const path of xmlParts(zip, ext)) {
      const doc = parseXml(await zip.file(path).async('string'));
      docs[path] = doc;
      // {{표시}}
      els(doc, 'p').forEach(p => {
        const full = paraText(p);
        let m, has = false;
        MARK.lastIndex = 0;
        while ((m = MARK.exec(full))) { fl.add(m[1]); has = true; }
        if (has) markerParas.push(p);
      });
      // 표의 빈칸:  [성명][   ]  또는  위 칸 제목 / 아래 빈칸
      els(doc, 'tbl').forEach(tbl => {
        const trs = kids(tbl, 'tr');
        const rows = trs.map(tr => kids(tr, 'tc'));
        const texts = rows.map(cells => cells.map(cellText));
        rows.forEach((cells, r) => {
          const used = new Set();
          for (let i = 0; i < cells.length - 1; i++) {
            if (isLabel(texts[r][i]) && texts[r][i + 1] === '' && !els(cells[i + 1], 'tbl').length) {
              blanks.push({ tc: cells[i + 1], key: fl.add(texts[r][i]) });
              used.add(i); used.add(i + 1); i++;
            }
          }
          // 세로형: 이 줄이 모두 제목이고 다음 줄이 모두 빈칸
          const next = rows[r + 1];
          if (!used.size && next && next.length === cells.length && cells.length >= 2 &&
              texts[r].every(isLabel) && texts[r + 1].every(s => s === '')) {
            cells.forEach((c, i) => blanks.push({ tc: next[i], key: fl.add(texts[r][i]) }));
          }
        });
      });
    }
    return {
      fields: fl.list(),
      async build(values) {
        markerParas.forEach(p => fillMarkerPara(p, values, ext));
        blanks.forEach(b => { const v = values[b.key]; if (v) writeIntoCell(b.tc, String(v), ext); });
        Object.keys(docs).forEach(path => zip.file(path, serXml(docs[path])));
        if (zip.file('mimetype')) {
          const mt = await zip.file('mimetype').async('string');
          zip.file('mimetype', mt, { compression: 'STORE' });
        }
        return zip.generateAsync({ type: 'uint8array', compression: 'DEFLATE' });
      }
    };
  }

  /* ---- 엑셀(xlsx) ---- */
  function colNum(letters) { let n = 0; for (const ch of letters) n = n * 26 + (ch.charCodeAt(0) - 64); return n; }
  function parseRef(ref) {
    const m = /^([A-Z]+)(\d+)$/.exec(ref || '');
    return m ? { row: +m[2], col: colNum(m[1]) } : null;
  }
  async function loadXlsxForm(buf) {
    const zip = await root.JSZip.loadAsync(buf);
    const fl = FieldList();
    let ss = null, ssItems = [];
    if (zip.file('xl/sharedStrings.xml')) {
      ss = parseXml(await zip.file('xl/sharedStrings.xml').async('string'));
      ssItems = kids(ss.documentElement, 'si');
    }
    const cellStr = c => {
      const t = c.getAttribute('t');
      if (t === 's') { const v = kids(c, 'v')[0]; return v ? textOf(ssItems[+v.textContent]).trim() : ''; }
      if (t === 'inlineStr') return textOf(kids(c, 'is')[0]).trim();
      const v = kids(c, 'v')[0];
      return v ? v.textContent.trim() : '';
    };
    const isTextCell = c => ['s', 'inlineStr', 'str'].includes(c.getAttribute('t'));

    const sheets = {}, blanks = [], markerItems = [];
    // 표시: 공유 문자열 + 칸 안 문자열
    const scanMarks = node => {
      const s = textOf(node);
      let m, has = false;
      MARK.lastIndex = 0;
      while ((m = MARK.exec(s))) { fl.add(m[1]); has = true; }
      if (has) markerItems.push(node);
    };
    ssItems.forEach(scanMarks);

    const paths = Object.keys(zip.files).filter(n => /^xl\/worksheets\/sheet\d+\.xml$/.test(n)).sort(numSort);
    for (const path of paths) {
      const doc = parseXml(await zip.file(path).async('string'));
      sheets[path] = doc;
      els(doc, 'is').forEach(scanMarks);
      const cells = new Map();
      els(doc, 'c').forEach(c => {
        const p = parseRef(c.getAttribute('r'));
        if (p) cells.set(p.row + ',' + p.col, Object.assign({ el: c }, p));
      });
      const merges = els(doc, 'mergeCell').map(m => {
        const [a, b] = (m.getAttribute('ref') || '').split(':');
        const p1 = parseRef(a), p2 = parseRef(b || a);
        return p1 && p2 ? { r1: p1.row, c1: p1.col, r2: p2.row, c2: p2.col } : null;
      }).filter(Boolean);
      const mergeOf = (r, c) => merges.find(m => r >= m.r1 && r <= m.r2 && c >= m.c1 && c <= m.c2);
      const hidden = (r, c) => { const m = mergeOf(r, c); return m && !(m.r1 === r && m.c1 === c); };
      const emptyCell = (r, c) => {
        const x = cells.get(r + ',' + c);
        return x && !hidden(r, c) && cellStr(x.el) === '' && !kids(x.el, 'f').length ? x : null;
      };
      const usedLabels = new Set();
      const sorted = Array.from(cells.values()).sort((a, b) => a.row - b.row || a.col - b.col);
      // 가로형 [성명][  ]
      sorted.forEach(x => {
        if (hidden(x.row, x.col) || !isTextCell(x.el)) return;
        const label = cellStr(x.el);
        if (!isLabel(label)) return;
        const m = mergeOf(x.row, x.col);
        const target = emptyCell(x.row, (m ? m.c2 : x.col) + 1);
        if (target) { blanks.push({ doc, el: target.el, key: fl.add(label) }); usedLabels.add(x.row + ',' + x.col); }
      });
      // 세로형: 제목 줄 아래가 빈칸
      const byRow = {};
      sorted.forEach(x => {
        if (hidden(x.row, x.col) || !isTextCell(x.el) || usedLabels.has(x.row + ',' + x.col)) return;
        const label = cellStr(x.el);
        if (!isLabel(label)) return;
        const m = mergeOf(x.row, x.col);
        const target = emptyCell((m ? m.r2 : x.row) + 1, x.col);
        if (target) (byRow[x.row] = byRow[x.row] || []).push({ label, target });
      });
      Object.values(byRow).forEach(list => {
        if (list.length >= 2) list.forEach(o => blanks.push({ doc, el: o.target.el, key: fl.add(o.label) }));
      });
    }

    return {
      fields: fl.list(),
      async build(values) {
        markerItems.forEach(node => fillMarkerPara(node, values, 'xlsx'));
        blanks.forEach(b => {
          const v = values[b.key];
          if (!v) return;
          const c = b.el, ns = c.namespaceURI, doc = c.ownerDocument;
          ['v', 'f', 'is'].forEach(n => kids(c, n).forEach(x => c.removeChild(x)));
          const s = String(v);
          if (/^-?(0|[1-9]\d{0,14})(\.\d+)?$/.test(s)) {
            c.removeAttribute('t');
            const ve = doc.createElementNS(ns, 'v'); ve.textContent = s; c.appendChild(ve);
          } else {
            c.setAttribute('t', 'inlineStr');
            const is = doc.createElementNS(ns, 'is'), t = doc.createElementNS(ns, 't');
            t.textContent = s; is.appendChild(t); c.appendChild(is);
          }
        });
        if (ss) zip.file('xl/sharedStrings.xml', serXml(ss));
        Object.keys(sheets).forEach(p => zip.file(p, serXml(sheets[p])));
        // 계산식이 있으면 파일을 열 때 다시 계산
        if (zip.file('xl/workbook.xml')) {
          const wb = parseXml(await zip.file('xl/workbook.xml').async('string'));
          const cp = els(wb, 'calcPr')[0];
          if (cp) { cp.setAttribute('fullCalcOnLoad', '1'); zip.file('xl/workbook.xml', serXml(wb)); }
        }
        return zip.generateAsync({ type: 'uint8array', compression: 'DEFLATE' });
      }
    };
  }

  /* ---- PDF ---- */
  const FONT_URL = 'https://cdn.jsdelivr.net/npm/@expo-google-fonts/gothic-a1@0.4.1/400Regular/GothicA1_400Regular.ttf';
  let fontCache = null;
  async function koreanFont() {
    if (fontCache) return fontCache;
    if (root.__KOREAN_FONT_BYTES) return (fontCache = root.__KOREAN_FONT_BYTES);
    const res = await fetch(FONT_URL);
    if (!res.ok) throw new Error('한글 글꼴을 불러오지 못했어요. 인터넷 연결을 확인해 주세요.');
    return (fontCache = new Uint8Array(await res.arrayBuffer()));
  }

  async function loadPdfForm(buf) {
    const { PDFDocument } = root.PDFLib;
    const fl = FieldList();
    const probe = await PDFDocument.load(buf.slice(0), { ignoreEncryption: true });
    const textFields = [];
    try {
      probe.getForm().getFields().forEach(f => {
        if (f.constructor && f.constructor.name === 'PDFTextField' || typeof f.setText === 'function') {
          textFields.push({ name: f.getName(), key: fl.add(f.getName().replace(/^.*\./, '')) });
        }
      });
    } catch (e) { /* 입력칸 없는 PDF */ }
    // {{표시}} 위치 찾기 (같은 줄 글자 조각을 이어 붙여서 찾음)
    const marks = [];
    if (root.pdfjsLib) {
      const pdf = await root.pdfjsLib.getDocument({ data: new Uint8Array(buf.slice(0)) }).promise;
      for (let i = 1; i <= pdf.numPages; i++) {
        const tc = await (await pdf.getPage(i)).getTextContent();
        const lines = [];
        tc.items.forEach(it => {
          if (!it.str) return;
          const y = it.transform[5], h = Math.hypot(it.transform[2], it.transform[3]) || 10;
          let line = lines.find(l => Math.abs(l.y - y) < h * 0.5);
          if (!line) { line = { y, h, items: [] }; lines.push(line); }
          line.items.push({ x: it.transform[4], w: it.width, s: it.str });
        });
        lines.forEach(l => {
          l.items.sort((a, b) => a.x - b.x);
          let text = '';
          const segs = l.items.map(it => { const sg = { start: text.length, it }; text += it.s; return sg; });
          const xAt = pos => {                              // 글자 위치 → 가로 좌표
            let sg = segs[0];
            segs.forEach(g => { if (g.start <= pos) sg = g; });
            const len = sg.it.s.length || 1;
            return sg.it.x + Math.min(pos - sg.start, len) / len * sg.it.w;
          };
          let m; MARK.lastIndex = 0;
          while ((m = MARK.exec(text))) {
            fl.add(m[1]);
            const x1 = xAt(m.index), x2 = xAt(m.index + m[0].length);
            marks.push({ page: i - 1, x: x1, y: l.y, w: Math.max(x2 - x1, 1), h: l.h, key: norm(m[1]) });
          }
        });
      }
    }
    return {
      fields: fl.list(),
      async build(values) {
        const { rgb } = root.PDFLib;
        const doc = await PDFDocument.load(buf.slice(0), { ignoreEncryption: true });
        doc.registerFontkit(root.fontkit);
        const font = await doc.embedFont(await koreanFont(), { subset: false });
        if (textFields.length) {
          const form = doc.getForm();
          textFields.forEach(tf => {
            const v = values[tf.key];
            if (v) { try { form.getTextField(tf.name).setText(String(v)); } catch (e) {} }
          });
          form.updateFieldAppearances(font);
        }
        const pages = doc.getPages();
        marks.forEach(mk => {
          const page = pages[mk.page];
          page.drawRectangle({ x: mk.x - 0.5, y: mk.y - mk.h * 0.3, width: mk.w + 1, height: mk.h * 1.3, color: rgb(1, 1, 1) });
          const txt = values[mk.key] == null ? '' : String(values[mk.key]);
          if (txt.trim()) page.drawText(txt, { x: mk.x, y: mk.y, size: mk.h, font, color: rgb(0, 0, 0) });
        });
        return doc.save();
      }
    };
  }

  /* ---- 양식 열기 (형식별로 나눠 보내기) ---- */
  // 출력할 때마다 원본에서 새로 읽어서 채움 (여러 번 출력해도 안전)
  async function loadForm(name, buf) {
    const first = await loadFormOnce(name, buf);
    return {
      fields: first.fields,
      async build(values) { return (await loadFormOnce(name, buf)).build(values); }
    };
  }
  async function loadFormOnce(name, buf) {
    const ext = extOf(name);
    if (['hwpx', 'docx', 'pptx'].includes(ext)) return loadZipForm(buf, ext);
    if (ext === 'xlsx' || ext === 'xlsm') return loadXlsxForm(buf);
    if (ext === 'pdf') return loadPdfForm(buf);
    if (ext === 'xls') throw new Error(OLD_MSG.xlsForm);
    if (OLD_MSG[ext]) throw new Error(OLD_MSG[ext]);
    throw new Error('이 형식(.' + ext + ')은 양식으로 쓸 수 없어요.');
  }

  const MIME = {
    hwpx: 'application/hwp+zip',
    docx: 'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
    pptx: 'application/vnd.openxmlformats-officedocument.presentationml.presentation',
    xlsx: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
    xlsm: 'application/vnd.ms-excel.sheet.macroEnabled.12',
    pdf: 'application/pdf'
  };

  const api = { norm, extOf, readDataFile, loadForm, matchAll, MIME };
  if (typeof module !== 'undefined' && module.exports) module.exports = api;
  else root.FormEngine = api;
})(typeof window !== 'undefined' ? window : globalThis);
